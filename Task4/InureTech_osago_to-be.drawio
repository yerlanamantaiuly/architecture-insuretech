  <diagram id="task4-osago-to-be" name="InureTech OSAGO to-be">
    <mxGraphModel dx="1800" dy="1050" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="InsureTech: оформление ОСАГО онлайн" style="text;html=1;strokeColor=none;fillColor=none;fontSize=24;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="450" y="20" width="900" height="40" as="geometry" />
        </mxCell>
        <mxCell id="goal" value="Цель: пользователь видит предложения страховых компаний сразу по мере поступления ответов. Максимальное ожидание ответа от страховой компании — 60 секунд. Пиковая нагрузка — до 2500 одновременных пользователей." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="360" y="70" width="1080" height="60" as="geometry" />
        </mxCell>
        <mxCell id="web" value="Веб-приложение клиентов&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;форма заявки ОСАГО&lt;br&gt;экран частичных результатов&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="80" y="220" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="partners" value="B2B партнёры" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="80" y="350" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="core" value="core-app&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;пользовательский сценарий ОСАГО&lt;br&gt;валидация заявки&lt;br&gt;агрегация результатов для UI&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="390" y="220" width="260" height="115" as="geometry" />
        </mxCell>
        <mxCell id="coreDb" value="PostgreSQL schema core-app&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;заявка клиента&lt;br&gt;статус поиска&lt;br&gt;полученные предложения&lt;br&gt;outbox&lt;/font&gt;" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="390" y="370" width="260" height="120" as="geometry" />
        </mxCell>
        <mxCell id="osago" value="osago-aggregator&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;создание заявок в страховых компаниях&lt;br&gt;polling предложений&lt;br&gt;нормализация ответов&lt;br&gt;контроль 60 секунд&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="790" y="220" width="280" height="125" as="geometry" />
        </mxCell>
        <mxCell id="osagoDb" value="PostgreSQL schema osago-aggregator&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;osagoRequestId&lt;br&gt;externalRequestId по каждой СК&lt;br&gt;статусы polling&lt;br&gt;сырые и нормализованные ответы&lt;br&gt;outbox&lt;/font&gt;" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="790" y="390" width="280" height="130" as="geometry" />
        </mxCell>
        <mxCell id="kafka" value="Event Streaming кластер&lt;br&gt;&lt;b&gt;Kafka-compatible broker&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;policy-events&lt;br&gt;product-catalog-events&lt;br&gt;osago-quote-events&lt;br&gt;dead-letter-events&lt;/font&gt;" style="shape=cylinder3d;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="600" y="620" width="250" height="230" as="geometry" />
        </mxCell>
        <mxCell id="clientInfo" value="client-info&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;данные клиента&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="390" y="540" width="230" height="75" as="geometry" />
        </mxCell>
        <mxCell id="productAggregator" value="ins-product-aggregator&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;каталог продуктов и тарифов&lt;br&gt;Event-Driven поток из Task3&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="80" y="640" width="260" height="95" as="geometry" />
        </mxCell>
        <mxCell id="settlement" value="ins-comp-settlement&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;взаиморасчёты по оформленным полисам&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="960" y="650" width="260" height="85" as="geometry" />
        </mxCell>
        <mxCell id="insurers" value="Страховые компании&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;однотипный REST API:&lt;br&gt;1. создать заявку ОСАГО&lt;br&gt;2. получить предложение по заявке&lt;br&gt;до 10 интеграций&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1280" y="220" width="260" height="130" as="geometry" />
        </mxCell>
        <mxCell id="patternsInsurers" value="Паттерны на внешних вызовах&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;Timeout: общий дедлайн 60 секунд&lt;br&gt;Retry: короткий backoff только для временных ошибок&lt;br&gt;Circuit Breaker: изоляция нестабильной СК&lt;br&gt;Rate Limiting: лимиты по каждой СК&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1280" y="390" width="300" height="135" as="geometry" />
        </mxCell>
        <mxCell id="patternsApi" value="Паттерны на публичном и внутреннем API&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;Rate Limiting: защита от всплесков и партнёров&lt;br&gt;Timeout: быстрый ответ core-app при создании поиска&lt;br&gt;Idempotency-Key: повторная отправка формы без дублей&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="80" y="470" width="300" height="115" as="geometry" />
        </mxCell>
        <mxCell id="apiCore" value="API core-app для веб-приложения&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;POST /osago/applications — создать поиск&lt;br&gt;GET /osago/applications/{id} — состояние&lt;br&gt;SSE /osago/applications/{id}/events — предложения по мере поступления&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="80" y="80" width="280" height="110" as="geometry" />
        </mxCell>
        <mxCell id="apiOsago" value="API osago-aggregator для core-app&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;POST /osago/requests — запустить fan-out&lt;br&gt;GET /osago/requests/{id} — текущее состояние&lt;br&gt;событие OsagoQuoteReceived — ответ СК&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="790" y="80" width="300" height="110" as="geometry" />
        </mxCell>
        <mxCell id="replicas" value="Учитываем несколько экземпляров сервисов&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;Состояние polling хранится в БД osago-aggregator, поэтому любой pod может продолжить обработку. Потребители событий работают в consumer group. Идемпотентность обязательна.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6d0de;strokeColor=#996185;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="960" y="790" width="420" height="100" as="geometry" />
        </mxCell>
        <mxCell id="observability" value="Наблюдаемость&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;latency по каждой СК&lt;br&gt;доля ответов за 60 секунд&lt;br&gt;ошибки polling&lt;br&gt;consumer lag&lt;br&gt;DLQ&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6d0de;strokeColor=#996185;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1280" y="650" width="260" height="125" as="geometry" />
        </mxCell>
        <mxCell id="flow1" value="1. POST заявка ОСАГО&lt;br&gt;REST + Idempotency-Key" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=12;" edge="1" parent="1" source="web" target="core">
          <mxGeometry relative="1" as="geometry" />
